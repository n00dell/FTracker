import { Palette } from "../NavMenu/MenuItems.slint";
import { Card } from "../Dash/Cards.slint";
import { AppButton } from "../Dash/DashButton.slint";
import { ColHead } from "../Savings/ColHead.slint";
import { ItemRow, ItemData, ItemCols } from "ItemRow.slint";

// Right column: header with "Add item", then the items of the selected category.
export component ItemsCard inherits Card {
    in property <string> category-name: "Transport";
    in property <string> subtitle: "Items appear as one-tap choices when you add an entry.";
    in property <[ItemData]> items;
    callback add-item();
    callback edit-item(int);                 // item id

    clip: true;

    VerticalLayout {
        alignment: start;

        // Card header
        Rectangle {
            height: 70px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: root.category-name; font-family: Palette.font-body; font-size: 16px; font-weight: 600; color: Palette.fg; overflow: elide; }
                    Text { text: root.subtitle; font-family: Palette.font-body; font-size: 13px; color: Palette.muted; overflow: elide; }
                }
                VerticalLayout {
                    alignment: center;
                    AppButton {
                        width: 116px;
                        primary: true;
                        text: "Add item";
                        icon: @image-url("../icons/icons8-add-100.png");
                        clicked => { root.add-item(); }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.line; }
        }

        // Column headings
        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 8px;
                ColHead { horizontal-stretch: 1; text: "ITEM"; }
                ColHead { width: ItemCols.amount; text: "DEFAULT AMOUNT"; horizontal-alignment: right; }
                ColHead { width: ItemCols.rule; text: "RULE"; }
                Rectangle { width: ItemCols.edit; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.line; }
        }

        for it in root.items: ItemRow {
            data: it;
            edit-clicked => { root.edit-item(it.id); }
        }

        if root.items.length == 0: Rectangle {
            height: 72px;
            Text {
                text: "No items yet. Add the first one.";
                font-family: Palette.font-body;
                font-size: 14px;
                color: Palette.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}