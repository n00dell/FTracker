import { EntryRow, EntryKind, EntryData } from "ExpenseEntryRow.slint";
import { AddEntryRow, SuggestionData } from "AddEntryRow.slint";
import { LinkText } from "../Dash/Cards.slint";
import { MoneyText } from "../Dash/MoneyText.slint";
import { Palette } from "../NavMenu/MenuItems.slint";

// One category (Transport, Food, ...) for the selected day. Dash.slint repeats this.
export struct BucketData {
    name: string,
    subtotal: string,          // number only, no "KES"
    entries: [EntryData],
}

// A layout (not a Rectangle) so Flickable in Dash.slint can measure its height.
export component ExpenseBucket inherits VerticalLayout {
    in property <string> bucket-header: "Transport";
    in property <string> subtotal-amount: "0";
    in property <[EntryData]> entries;
    in property <bool> select-mode: false;
    in property <bool> adding: false;                 // show the inline add form
    in property <bool> hidden: false;                 // draw nothing at all (see Dash.slint for when)
    in property <string> add-link-text: "Add entry";  // "Add one-off" for the One-offs bucket
    in property <[SuggestionData]> suggestions;

    callback add-requested();
    callback entry-toggled(int, bool);          // entry id, ticked
    callback amount-accepted(int, string);      // entry id, new text
    callback fund-clicked(int);
    callback delete-clicked(int);
    callback add-name-edited(string);
    callback add-suggestion-picked(int);
    callback add-saved(string, string);
    callback add-cancelled();
    callback open-categories();

    spacing: 0px;

    // Empty and not adding: one slim line with a top rule only, name in bold
    if !root.hidden && root.entries.length == 0 && !root.adding: Rectangle {
        height: 41px;
        Rectangle { y: 0px; height: 1px; background: Palette.line-soft; }
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 8px;
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 0px;
                Text { text: root.bucket-header; font-family: Palette.font-body; font-size: 13px; font-weight: 600; color: Palette.muted; vertical-alignment: center; }
                Text { text: " · nothing today"; font-family: Palette.font-body; font-size: 13px; color: Palette.muted; vertical-alignment: center; }
            }
            VerticalLayout {
                alignment: center;
                LinkText { width: 84px; size: 13px; text: root.add-link-text; clicked => { root.add-requested(); } }
            }
        }
    }

    // Has rows (or is being added to)
    if !root.hidden && (root.entries.length > 0 || root.adding): VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 39px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 6px;
                spacing: 8px;
                Text { horizontal-stretch: 1; text: root.bucket-header; font-family: Palette.font-body; font-size: 14px; font-weight: 600; color: Palette.fg; vertical-alignment: center; }
                MoneyText { width: 100px; text: root.subtotal-amount; size: 13px; ink: Palette.muted; }
            }
        }

        for e in root.entries: EntryRow {
            data: e;
            select-mode: root.select-mode;
            toggled(on) => { root.entry-toggled(e.id, on); }
            amount-accepted(t) => { root.amount-accepted(e.id, t); }
            fund-clicked => { root.fund-clicked(e.id); }
            delete-clicked => { root.delete-clicked(e.id); }
        }

        if !root.adding: Rectangle {
            height: 38px;
            Rectangle { y: 0px; height: 1px; background: Palette.line-soft; }
            HorizontalLayout {
                padding-left: 18px;
                VerticalLayout {
                    alignment: center;
                    LinkText { width: 100px; text: root.add-link-text; clicked => { root.add-requested(); } }
                }
            }
        }
        if root.adding: AddEntryRow {
            suggestions: root.suggestions;
            name-edited(t) => { root.add-name-edited(t); }
            suggestion-picked(i) => { root.add-suggestion-picked(i); }
            saved(n, a) => { root.add-saved(n, a); }
            cancelled => { root.add-cancelled(); }
            open-categories => { root.open-categories(); }
        }

        // divider between buckets
        Rectangle { height: 1px; background: Palette.line; }
    }
}