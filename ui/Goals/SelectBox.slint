import { Palette } from "../NavMenu/MenuItems.slint";

// Dropdown. Click to open a list under the box, click an option to pick it.
// Reusable wherever the design has a <select> (Tracks pot, Funded from, Move to pot, ...).
export component SelectBox inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index: 0;
    callback selected(int);

    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? Palette.accent : Palette.line;
    background: Palette.surface;
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.options[root.current-index];
            font-family: Palette.font-body;
            font-size: 14px;
            color: Palette.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 2.5 4.5 L 6 8 L 9.5 4.5";
                stroke: Palette.faint;
                stroke-width: 1.6px;
                fill: transparent;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.width;
        height: root.options.length * 32px + 8px;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.line;
            background: Palette.surface;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: rgba(17, 24, 39, 0.12);

            VerticalLayout {
                padding: 4px;
                for o[i] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: oa.has-hover || i == root.current-index ? Palette.accent-soft : transparent;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: o;
                        font-family: Palette.font-body;
                        font-size: 14px;
                        font-weight: i == root.current-index ? 600 : 400;
                        color: i == root.current-index ? Palette.accent-ink : Palette.fg;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    oa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}