import "../fonts/DMSans-Regular.ttf";
 import "../fonts/DMSans-Medium.ttf";
 import "../fonts/DMSans-SemiBold.ttf";
 import "../fonts/JetBrainsMono-Regular.ttf";
 import "../fonts/JetBrainsMono-Medium.ttf";

export struct NavText {
    name: string,
    icon: image,
    group: string,
}

// Tokens copied from the :root block of Pesa Desktop(1).html (light theme)
export global Palette {
    // surfaces and lines
    out property <color> bg: #F5F7F8;
    out property <color> surface: #FFFFFF;
    out property <color> line: #E3E7E9;
    out property <color> line-soft: #EEF1F2;

    // text
    out property <color> fg: #111827;
    out property <color> muted: #4B5563;
    out property <color> faint: #6B7280;

    // brand
    out property <color> accent: #0F766E;
    out property <color> accent-hover: #0B5F58;
    out property <color> accent-fg: #FFFFFF;
    out property <color> accent-soft: #E3F2EF;
    out property <color> accent-ink: #0B5F58;

    // status
    out property <color> pos: #15803D;
    out property <color> neg: #B91C1C;
    out property <color> warn: #B45309;
    out property <color> warn-soft: #FEF3C7;
    out property <color> neg-soft: #FEE2E2;
    out property <color> info-soft: #DBEAFE;
    out property <color> info-ink: #1D4ED8;

    // entry row backgrounds
    out property <color> r-edit: #FEF3C7;
    out property <color> r-man: #DBEAFE;
    out property <color> r-skip: #F1F3F4;

    // entry row left stripes
    out property <color> s-auto: #0F766E;
    out property <color> s-edit: #D97706;
    out property <color> s-man: #3B82F6;
    out property <color> s-skip: #6B7280;
    out property <color> s-exp: #9CA3AF;

    // fonts
    out property <string> font-body: "DM Sans";
    out property <string> font-mono: "JetBrains Mono";

    // old names, so nothing else you wrote breaks
    out property <color> teal: accent;
    out property <color> teal-soft: accent-soft;
    out property <color> text: fg;
    out property <color> divider: line;
}

export component NavGroup inherits HorizontalLayout {
    in property <string> label;
    padding-left: 10px;
    padding-top: 14px;
    padding-bottom: 4px;
    Text {
        text: root.label;
        font-family: Palette.font-body;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: Palette.faint;
        vertical-alignment: center;
    }
}

export component NavItems inherits Rectangle {
    in property <NavText> item;
    in property <bool> active: false;
    in property <int> badge: 0;
    callback clicked();

    height: 36px;
    border-radius: 8px;
    background: transparent;
    animate background { duration: 150ms; }

    states [
        active when root.active: {
            background: Palette.accent-soft;
        }
        hover when ta.has-hover && !root.active: {
            background: Palette.line-soft;
        }
    ]

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Image {
            source: root.item.icon;
            width: 16px;
            image-fit: contain;
            colorize: root.active ? Palette.accent-ink : Palette.muted;
        }

        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            vertical-alignment: center;
            font-family: Palette.font-body;
            font-size: 14px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Palette.accent-ink : (ta.has-hover ? Palette.fg : Palette.muted);
        }

        if root.badge > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 18px;
                border-radius: 9px;
                background: Palette.neg-soft;
                Text {
                    text: root.badge;
                    font-family: Palette.font-body;
                    font-size: 11px;
                    font-weight: 600;
                    color: Palette.neg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================
// In MenuItems.slint: DELETE the old `DateDisplay` component at the
// bottom of the file and paste everything below in its place.
// Nothing else in MenuItems.slint changes.
// ============================================================

// Underlined teal text link (the design's .link).
// Cards.slint has LinkText, but Cards.slint imports this file, so importing it
// here would be a circular import. This is a small local copy.
// Give it a width, or let a VerticalLayout stretch it: the underline only covers the text.
component FooterLink inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 18px;

    label := Text {
        width: parent.width;
        text: root.text;
        font-family: Palette.font-body;
        font-size: 12px;
        font-weight: 500;
        color: ta.has-hover ? Palette.accent : Palette.accent-ink;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: 0px;
        y: parent.height / 2 + label.preferred-height / 2 - 1px;
        width: min(label.preferred-width, parent.width);
        height: 1px;
        background: ta.has-hover ? Palette.accent : Palette.accent-ink;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The "Preview states" line: small chevron + text, no underline (like <summary>).
component FooterToggle inherits Rectangle {
    in property <string> text;
    in property <bool> open: false;
    callback clicked();

    height: 18px;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: root.open ? "M 2.5 4.5 L 6 8 L 9.5 4.5" : "M 4.5 2.5 L 8 6 L 4.5 9.5";
                stroke: ta.has-hover ? Palette.accent : Palette.accent-ink;
                stroke-width: 1.6px;
                fill: transparent;
            }
        }
        Text {
            text: root.text;
            font-family: Palette.font-body;
            font-size: 12px;
            font-weight: 500;
            color: ta.has-hover ? Palette.accent : Palette.accent-ink;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Bottom block of the sidebar, same order as the design:
// period, payday, [Configure AI | Backup and lock], [Switch theme | Example data],
// then the collapsible "Preview states" list.
export component DateDisplay inherits VerticalLayout {
    in property <string> period: "Period since 25 Sep";
    in property <string> payday: "Payday expected about 24 Oct";
    in property <string> data-note: "Example data";   // grey note at the right of the theme row, "" hides it
    callback configure-ai();            // popup
    callback backup-and-lock();         // popup
    callback switch-theme();
    callback preview-state(string);     // key: late, fresh, due, bulk, wipe, first, skipday, nopay, clock

    property <bool> demo-open: false;
    property <[{ key: string, label: string }]> demos: [
        { key: "late", label: "Payday is late" },
        { key: "fresh", label: "New period, no entries" },
        { key: "due", label: "Goal due dialog" },
        { key: "bulk", label: "Past-dated rule preview" },
        { key: "wipe", label: "Wipe all preview" },
        { key: "first", label: "First-run setup" },
        { key: "skipday", label: "Jump to a skipped day" },
        { key: "nopay", label: "No expected pay set" },
        { key: "clock", label: "Computer clock is behind" },
    ];

    spacing: 0px;

    Rectangle {
        height: 1px;
        background: Palette.line;
    }
    VerticalLayout {
        padding-top: 12px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Text { text: root.period; font-family: Palette.font-body; font-size: 12px; color: Palette.muted; }
        Text { text: root.payday; font-family: Palette.font-body; font-size: 12px; color: Palette.muted; }

        HorizontalLayout {
            height: 18px;
            FooterLink { width: 76px; text: "Configure AI"; clicked => { root.configure-ai(); } }
            Rectangle { horizontal-stretch: 1; }
            FooterLink { width: 104px; text: "Backup and lock"; clicked => { root.backup-and-lock(); } }
        }

        HorizontalLayout {
            height: 18px;
            FooterLink { width: 84px; text: "Switch theme"; clicked => { root.switch-theme(); } }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.data-note;
                font-family: Palette.font-body;
                font-size: 12px;
                color: Palette.faint;
                vertical-alignment: center;
            }
        }

        FooterToggle {
            text: "Preview states";
            open: root.demo-open;
            clicked => { root.demo-open = !root.demo-open; }
        }

        if root.demo-open: VerticalLayout {
            spacing: 4px;
            for d in root.demos: FooterLink {
                text: d.label;
                clicked => {
                    root.demo-open = false;     // the design closes the list after a pick
                    root.preview-state(d.key);
                }
            }
        }
    }
}