import { Palette } from "../NavMenu/MenuItems.slint";

// One chip in the Skip days card
export component SkipChip inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    callback remove();

    height: 44px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.line;
    background: Palette.surface;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.name;
                font-family: Palette.font-body;
                font-size: 13px;
                font-weight: 600;
                color: Palette.fg;
            }
            Text {
                text: root.detail;
                font-family: Palette.font-body;
                font-size: 12px;
                color: Palette.muted;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                background: x-ta.has-hover ? Palette.neg-soft : transparent;
                Text {
                    text: "×";
                    font-size: 16px;
                    color: x-ta.has-hover ? Palette.neg : Palette.faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                x-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

