import { Palette } from "../NavMenu/MenuItems.slint";

export component Card inherits Rectangle {
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.line;
    drop-shadow-blur: 2px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: rgba(17, 24, 39, 0.06);
}

// Small rounded label. kind: 0 teal, 1 amber, 2 red, 3 grey, 4 blue
export component Chip inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0;

    height: 20px;
    border-radius: 10px;
    background: root.kind == 1 ? Palette.warn-soft
        : root.kind == 2 ? Palette.neg-soft
        : root.kind == 3 ? Palette.line-soft
        : root.kind == 4 ? Palette.info-soft
        : Palette.accent-soft;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-family: Palette.font-body;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            color: root.kind == 1 ? Palette.warn
                : root.kind == 2 ? Palette.neg
                : root.kind == 3 ? Palette.muted
                : root.kind == 4 ? Palette.info-ink
                : Palette.accent-ink;
        }
    }
}

// Teal underlined text that acts like a link (the design's .link). Give it a width.
// Slint has no text-decoration property, so the underline is its own 1px rectangle.
export component LinkText inherits Rectangle {
    in property <string> text;
    in property <length> size: 14px;
    callback clicked();
    height: 20px;
    label := Text {
        width: parent.width;   // otherwise the text is centred in the box
        text: root.text;
        font-family: Palette.font-body;
        font-size: root.size;
        font-weight: 500;
        color: ta.has-hover ? Palette.accent : Palette.accent-ink;
        vertical-alignment: center;
    }
    Rectangle {
        x: 0px;
        y: parent.height / 2 + label.preferred-height / 2 - 1px;
        width: min(label.preferred-width, parent.width);
        height: 1px;
        background: ta.has-hover ? Palette.accent : Palette.accent-ink;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}