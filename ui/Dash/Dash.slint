

import { Palette } from "../NavMenu/MenuItems.slint";
import { AppButton } from "DashButton.slint";
import { Card } from "Cards.slint";
import { EarnedCard, SpendMeter } from "EarnedCard.slint";
import { SavingsCard } from "SavingsCard.slint";
import { StatCard } from "StatCard.slint";
import { DateBar } from "DateBar.slint";
import { DayPicker } from "DatePicker.slint";
import { ExpenseBucket } from "../Expenses/ExpenseBucket.slint";

export component DashCont inherits Rectangle {
    // ---------- Data in ----------
    // Numbers only. "KES" is drawn by EarnedCard itself.
    in property <string> earned-remaining: "42,300";
    in property <string> status-text: "On pace · about 18,200 left at payday";
    in property <int> status-kind: 0;          // 0 on pace, 1 tight, 2 over pace
    in property <bool> earned-low: false;      // red number when earned is 0 or less

    in property <string> savings: "85,000";
    in property <string> spent: "27,700";
    in property <string> income: "70,000";
    in property <string> safe-per-day: "1,950";
    in property <float> spent-fraction: 0.396; // 0.0 to 1.0, drives the thin meter

    // Date bar
    in property <string> day-label: "Tue 6 Oct";
    in property <bool> day-upcoming: false;

    // Selection state, worked out by the table / your C++ backend.
    // Default is 2 so you can SEE the bar in the preview. Set to 0 to hide it.
    in property <int> selected-count: 2;
    in property <string> selected-total: "KES 340";

    // ---------- Events out ----------
    callback got-paid();
    callback move-to-earned();
    callback enter-select-mode();      // the "Cover from savings" button in the band
    callback cover-from-savings();     // the button in the selection bar
    callback clear-selection();

    callback date-back();
    callback date-forward();
    callback set-date-today();
    callback add-one-off();
    callback date-picked(int, int, int);   // year, month, day

    // [GLASS] translucent background. [PLAIN] use: background: #f6f8f9;
    background: @linear-gradient(160deg, rgba(255, 255, 255, 0.78) 0%, rgba(240, 249, 247, 0.62) 100%);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        // ---------- Header ----------
        HorizontalLayout {
            height: 36px;
            Text {
                text: "Dashboard";
                font-family: Palette.font-body;
                font-size: 24px;
                font-weight: 600;
                color: Palette.fg;
                vertical-alignment: center;
            }
        }

        // ---------- Summary band ----------
        // Left: earned number, four stats, spend meter. Right: the action buttons.
        Card {
            height: 176px;

            HorizontalLayout {
                padding: 20px;
                spacing: 28px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    alignment: start;

                    EarnedCard {
                        value: root.earned-remaining;
                        status-text: root.status-text;
                        status-kind: root.status-kind;
                        low: root.earned-low;
                    }

                    HorizontalLayout {
                        spacing: 36px;
                        alignment: start;

                        SavingsCard { value: root.savings; }
                        StatCard { label: "Spent this period"; value: root.spent; }
                        StatCard { label: "Income this period"; value: root.income; }
                        StatCard { label: "Safe to spend per day"; value: root.safe-per-day; }
                    }

                    SpendMeter { fraction: root.spent-fraction; }
                }

                VerticalLayout {
                    width: 190px;
                    spacing: 8px;
                    alignment: center;

                    AppButton {
                        text: "I got paid";
                        primary: true;
                        clicked => { root.got-paid(); }
                    }
                    AppButton {
                        text: "Cover from savings";
                        clicked => { root.enter-select-mode(); }
                    }
                    AppButton {
                        text: "Move savings to earned";
                        clicked => { root.move-to-earned(); }
                    }
                }
            }
        }

        // ---------- Day card: date bar, selection bar, entries ----------
        Card {
            vertical-stretch: 1;
            clip: true;

            VerticalLayout {
                alignment: start;

                DateBar {
                    DateinWords: root.day-label;
                    upcoming: root.day-upcoming;
                    date-back => { root.date-back(); }
                    date-forward => { root.date-forward(); }
                    set-date-today => { root.set-date-today(); }
                    add-one-off => { root.add-one-off(); }
                    date-picker => { picker.open(); }
                }

                // Only exists while something is ticked.
                // "if" removes it from the layout completely, so the table moves up.
                if root.selected-count > 0: Rectangle {
                    height: 44px;
                    background: Palette.accent-soft;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;

                        Text {
                            text: root.selected-count + " selected  -  " + root.selected-total;
                            font-family: Palette.font-body;
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.accent-ink;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        AppButton {
                            width: 70px;
                            compact: true;
                            text: "Clear";
                            clicked => { root.clear-selection(); }
                        }
                        AppButton {
                            width: 170px;
                            compact: true;
                            text: "Cover from savings";
                            primary: true;
                            clicked => { root.cover-from-savings(); }
                        }
                    }
                }

                ExpenseBucket {}
            }
        }
    }

    // Keep this LAST and outside the layout so it covers the page and the popup centres on it.
    picker := DayPicker {
        picked(y, m, d) => { root.date-picked(y, m, d); }
    }
}