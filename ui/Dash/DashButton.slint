import { Palette } from "../NavMenu/MenuItems.slint";
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <image> icon;
    callback clicked();

    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.primary ? Palette.teal : Palette.divider;
    background: root.primary
        ? (ta.has-hover ? #0c625b : Palette.teal)
        : (ta.has-hover ? #f3f4f6 : white);
    HorizontalLayout {
    alignment: center;

            if root.icon.width > 0 : Image {
                source: root.icon;
                width: 16px;
                image-fit: contain;
                colorize: root.primary ? white : Palette.muted;
            }

            // Only exists when there is text
            if root.text != "" : Text {
                text: root.text;
                color: root.primary ? white : Palette.text;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }


}
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }


}